  "nodes": [
    {
      "parameters": {},
      "id": "43bb86d0-a1b3-47f1-9cec-46aff8594dfb",
      "name": "Fallo en un flujo",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst flujo = e.workflow?.name ?? 'desconocido';\nconst paso = e.execution?.lastNodeExecuted ?? e.trigger?.error?.node?.name ?? null;\nconst causa = String(e.execution?.error?.message ?? e.trigger?.error?.message ?? 'Sin detalle').slice(0, 290);\nreturn [{ json: { flujo: flujo.slice(0, 60), escenario: 'otro', resultado: 'error', paso_fallido: paso, tipo_error: 'desconocido', causa } }];"
      },
      "id": "53300797-0151-44e9-94cf-7179d07498ab",
      "name": "Preparar registro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://noctiluz-backoffice.onrender.com/api/ejecuciones.php",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "id": "3bb4d6d1-944b-416a-bd15-f30ce010a714",
