        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const v = $('Validar cambio').first().json;\nconst r = $input.first().json;\nconst c = r.statusCode;\nconst cuerpo = typeof r.body === 'object' && r.body !== null ? r.body : {};\nconst ok = c >= 200 && c < 300 && cuerpo.ok === true;\nconst error = ok ? null : (cuerpo.error ?? r.error?.message ?? 'La tienda no responde.');\nconst transitorio = !c || c >= 500;\nreturn [{ json: {\n  http: 200,\n  respuesta: ok ? { ok: true, estado: cuerpo.estado, sin_cambios: cuerpo.sin_cambios === true } : { ok: false, error },\n  registro: {\n    flujo: 'n8n-estado-backoffice', escenario: 'estado', event_id: (v.event_id ?? '').slice(0, 40), resultado: ok ? 'ok' : 'error',\n    paso_fallido: ok ? null : 'Tienda: aplicar estado', tipo_error: ok ? null : (transitorio ? 'transitorio' : 'negocio'), causa: error, datos_entrada: v.envio,\n  },\n} }];"
      },
      "id": "c1e5a749-30a5-4cb0-867e-c8bde68d6dce",
      "name": "Interpretar tienda",
