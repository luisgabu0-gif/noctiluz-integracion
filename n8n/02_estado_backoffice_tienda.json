        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cadf0de5-d343-43c4-90b9-f8184a246d06",
              "leftValue": "={{ $json.valido }}",
              "rightValue": true,
