        }
      }
    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json.body ?? {};\nconst d = e.data ?? {};\nconst errores = [];\nif (e.event !== 'backoffice.status_change_requested') errores.push('evento desconocido');\nif (!/^NCZ-\\d{6}-[A-Z0-9]{6}$/.test(d.codigo ?? '')) errores.push('codigo');\nif (typeof d.estado !== 'string' || !d.estado) errores.push('estado');\nreturn [{ json: { valido: errores.length === 0, errores, event_id: e.event_id ?? null, envio: { version: 1, codigo: d.codigo, estado: d.estado, motivo: d.motivo ?? null, origen: 'backoffice' } } }];"
      },
      "id": "0cfebe95-01fa-4e95-a8a3-97c5d57bd470",
      "name": "Validar cambio",
      "type": "n8n-nodes-base.code",
