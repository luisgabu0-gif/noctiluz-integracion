    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst q = $('Clasificar mensaje').first().json;\nconst c = r.body ?? {};\nconst p = c.propuesta ?? {};\nlet aviso, linea;\nif (r.statusCode !== 200) {\n  aviso = 'No se ha podido guardar la decisión';\n  linea = '⚠️ ' + (c.error ?? 'El back-office no responde: vuelve a pulsar el botón.');\n} else if (c.resultado === 'ya_decidida') {\n  aviso = 'Ya estaba decidida';\n  linea = 'ℹ️ Ya estaba ' + p.estado + ' por ' + p.decidido_por;\n} else {\n  aviso = q.decision === 'aprobada' ? 'Aprobada' : 'Rechazada';\n  linea = (q.decision === 'aprobada' ? '✅ Aprobada' : '❌ Rechazada') + ' por ' + q.por +\n    (c.responder_tienda ? (c.enviar_cliente ? ' · enviada al cliente por Telegram' : ' · cliente sin Telegram: la verá en «Mi cuenta»') : '');\n}\nreturn [{ json: {\n  callback_id: q.callback_id, chat_id: q.chat_id, message_id: q.message_id, aviso,\n  texto: (q.texto_original.replace('Estado: pendiente de revisión', '') + '\\n' + linea).slice(0, 4090),\n  responder_tienda: c.responder_tienda === true, enviar_cliente: c.enviar_cliente === true,\n  cliente_chat: c.telegram_chat_id ?? null, respuesta: c.respuesta_cliente ?? null, incidencia: p.incidencia_codigo ?? null,\n} }];"
      },
