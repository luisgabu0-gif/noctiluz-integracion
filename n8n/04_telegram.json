    {
      "parameters": {
        "jsCode": "const u = $('Telegram').first().json;\nconst equipo = String($('Configuración').first().json.equipo ?? '');\nif (u.callback_query) {\n  const q = u.callback_query;\n  const m = /^(aprobar|rechazar):(\\d+)$/.exec(q.data ?? '');\n  const autorizado = String(q.message?.chat?.id) === equipo;\n  return [{ json: {\n    tipo: !m ? 'otro' : (autorizado ? 'decision' : 'no_autorizado'),\n    callback_id: q.id, chat_id: String(q.message?.chat?.id ?? ''), message_id: q.message?.message_id, texto_original: q.message?.text ?? '',\n    id: m ? Number(m[2]) : null, decision: m?.[1] === 'aprobar' ? 'aprobada' : 'rechazada',\n    por: [q.from?.first_name, q.from?.username ? '@' + q.from.username : null].filter(Boolean).join(' ') || 'Telegram',\n  } }];\n}\nconst msg = u.message ?? {};\nconst m = /^\\/start\\s+(\\S+)$/.exec((msg.text ?? '').trim());\nreturn [{ json: { tipo: m ? 'vincular' : 'ayuda', carga: m?.[1] ?? null, chat_id: String(msg.chat?.id ?? '') } }];"
      },
