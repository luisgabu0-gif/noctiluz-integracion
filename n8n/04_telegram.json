    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst chat = $('Clasificar mensaje').first().json.chat_id;\nconst c = r.body ?? {};\nconst texto = r.statusCode === 200\n  ? '✅ Hola, ' + c.nombre + '. Tu pedido ' + c.codigo + ' ya está vinculado: te responderemos por aquí si abres una incidencia. NOCTILUZ es un prototipo académico.'\n  : '⚠️ No hemos podido vincular el pedido: ' + (c.error ?? 'inténtalo de nuevo en un minuto.');\nreturn [{ json: { chat, texto } }];"
      },
