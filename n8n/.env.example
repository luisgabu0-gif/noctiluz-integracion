# Variables de n8n en Render, además de las de la base de datos. Sin secretos: los valores reales van en Render.
WEBHOOK_URL=https://noctiluz-n8n.onrender.com/
N8N_PROXY_HOPS=1
N8N_RUNNERS_GRANT_TOKEN_TTL=120

# Permite usar la variable de abajo dentro de los flujos
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# ID del chat de Telegram del equipo, que recibe las propuestas del agente y los avisos
TELEGRAM_CHAT_SOPORTE=

# Render gratuito (512 MB): ajustes para reducir los reinicios de n8n (salida 134)
NODE_OPTIONS=--max-old-space-size=384
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_TEMPLATES_ENABLED=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=72
