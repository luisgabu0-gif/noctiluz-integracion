    {
      "parameters": {
        "jsCode": "// Apartado 3 del contrato: traduce lo que dijo el back-office a lo que espera la tienda.\nconst v = $('Validar y normalizar').first().json;\nconst r = $input.first().json;\nconst codigo = r.statusCode;\nconst cuerpo = typeof r.body === 'object' && r.body !== null ? r.body : {};\nconst entidades = { 'order.created': 'pedido', 'order.status_changed': 'pedido', 'support.requested': 'incidencia', 'payment.simulated': 'pago' };\nconst salida = { id: v.id, tipo: v.tipo, incidenciaNueva: false, incidencia: cuerpo.incidencia ?? null };\n\nif (codigo >= 200 && codigo < 300) {\n  const nuevo = codigo === 201;\n  salida.http = nuevo ? 201 : 200;\n  salida.fallo = false;\n  salida.respuesta = nuevo\n    ? { ok: true, id: v.id, entidad: entidades[v.tipo], referencia: cuerpo.codigo ?? cuerpo.incidencia?.codigo ?? null }\n    : { ok: true, id: v.id, duplicado: cuerpo.resultado === 'duplicado', resultado: cuerpo.resultado ?? 'ok' };\n  salida.incidenciaNueva = v.tipo === 'support.requested' && cuerpo.resultado === 'ok';\n} else if (codigo >= 400 && codigo < 500 && cuerpo.tipo_error !== 'transitorio' && codigo !== 401) {\n  // El mensaje está mal: repetirlo no lo arreglará.\n  salida.http = 422;\n  salida.fallo = true;\n  salida.respuesta = { error: cuerpo.error ?? 'El back-office rechazó el mensaje.', campos: {} };\n} else {\n  // Back-office dormido, caído o pedido que aún no ha llegado: la tienda reintentará.\n  salida.http = 503;\n  salida.fallo = true;\n  salida.respuesta = { error: cuerpo.error ?? r.error?.message ?? 'El back-office no responde.' };\n}\nreturn [{ json: salida }];"
      },
