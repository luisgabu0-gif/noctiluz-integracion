    {
      "parameters": {
        "jsCode": "// Contrato de integración, apartado 7. Valida el mensaje y lo traduce al formato del back-office.\nconst e = $input.first().json.body ?? {};\nconst campos = {};\nconst TIPOS = ['order.created', 'payment.simulated', 'order.status_changed', 'support.requested'];\nconst ESTADOS = ['creado', 'pagado', 'en_preparacion', 'enviado', 'entregado', 'incidencia', 'cancelado'];\nconst MOTIVOS = ['pedido', 'envio', 'producto', 'devolucion', 'otro'];\nconst CODIGO = /^NCZ-\\d{6}-[A-Z0-9]{6}$/;\nconst EMAIL = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst num = (v) => typeof v === 'number' && Number.isFinite(v);\nconst iguales = (a, b) => Math.abs(a - b) < 0.011;\n\nif (e.version !== 1) campos.version = 'Versión no soportada: se espera 1.';\nif (typeof e.id !== 'string' || !/^[0-9a-f-]{36}$/i.test(e.id)) campos.id = 'Falta el id del evento o no es un UUID.';\nif (!TIPOS.includes(e.tipo)) campos.tipo = 'Tipo de evento no admitido.';\nif (typeof e.ocurrido_en !== 'string' || Number.isNaN(Date.parse(e.ocurrido_en))) campos.ocurrido_en = 'Falta la fecha o no es ISO 8601.';\nif (typeof e.datos !== 'object' || e.datos === null) campos.datos = 'Falta el objeto datos.';\n\nconst p = e.pedido;\nif (['order.created', 'order.status_changed', 'payment.simulated'].includes(e.tipo)) {\n  if (typeof p !== 'object' || p === null) {\n    campos.pedido = 'Falta la foto del pedido.';\n  } else {\n    if (!CODIGO.test(p.codigo ?? '')) campos['pedido.codigo'] = 'El código no tiene el formato NCZ-AAMMDD-XXXXXX.';\n    if (!ESTADOS.includes(p.estado)) campos['pedido.estado'] = 'Estado desconocido.';\n    if (!EMAIL.test(p.cliente?.email ?? '')) campos['pedido.cliente.email'] = 'Email no válido.';\n    if (typeof p.cliente?.nombre !== 'string' || p.cliente.nombre.trim().length < 3) campos['pedido.cliente.nombre'] = 'Falta el nombre.';\n    if (!Array.isArray(p.lineas) || p.lineas.length === 0) {\n      campos.lineas = 'Debe haber al menos una línea.';\n    } else {\n      p.lineas.forEach((l, i) => {\n        if (!Number.isInteger(l.cantidad) || l.cantidad < 1 || l.cantidad > 9) campos['lineas.' + i + '.cantidad'] = 'La cantidad debe ser de 1 a 9.';\n        if (!num(l.importe) || !num(l.precio_unitario) || !iguales(l.importe, l.cantidad * l.precio_unitario)) campos['lineas.' + i + '.importe'] = 'El importe no es cantidad × precio.';\n      });\n    }\n    const t = p.totales ?? {};\n    if (![t.subtotal, t.descuento, t.envio, t.base_imponible, t.iva, t.total].every(num)) {\n      campos.totales = 'Faltan importes.';\n    } else if (!iguales(t.total, t.subtotal - t.descuento + t.envio) || !iguales(t.total, t.base_imponible + t.iva)) {\n      campos.totales = 'Los totales no cuadran.';\n    }\n  }\n}\nconst inc = e.incidencia;\nif (e.tipo === 'support.requested') {\n  if (typeof inc !== 'object' || inc === null) {\n    campos.incidencia = 'Falta la foto de la incidencia.';\n  } else {\n    if (typeof inc.codigo !== 'string' || !inc.codigo) campos['incidencia.codigo'] = 'Falta el código.';\n    if (!MOTIVOS.includes(inc.motivo)) campos['incidencia.motivo'] = 'Motivo desconocido.';\n    if (typeof inc.mensaje !== 'string' || !inc.mensaje.trim()) campos['incidencia.mensaje'] = 'Falta el mensaje.';\n    if (!EMAIL.test(inc.cliente?.email ?? '')) campos['incidencia.cliente.email'] = 'Email no válido.';\n  }\n}\n\nconst valido = Object.keys(campos).length === 0;\nconst escenarios = { 'order.created': 'pedido', 'order.status_changed': 'estado', 'support.requested': 'incidencia', 'payment.simulated': 'pedido' };\nconst salida = { valido, campos, tipo: e.tipo ?? 'desconocido', id: typeof e.id === 'string' ? e.id : null, escenario: escenarios[e.tipo] ?? 'otro', original: e };\n\nif (valido) {\n  const sobre = { event_id: e.id, event: e.tipo, occurred_at: e.ocurrido_en, source: 'tienda-noctiluz' };\n  if (e.tipo === 'order.created') {\n    sobre.data = {\n      codigo: p.codigo, estado: p.estado, total: p.totales.total, metodo_envio: p.envio?.metodo ?? null, cupon: e.datos.cupon ?? null,\n      cliente: { nombre: p.cliente.nombre.trim(), email: p.cliente.email.trim().toLowerCase() },\n      lineas: p.lineas.map((l) => ({ sku: l.sku, descripcion: l.descripcion, cantidad: l.cantidad, importe: l.importe })),\n    };\n  } else if (e.tipo === 'order.status_changed') {\n    sobre.data = { codigo: p.codigo, de: e.datos.de, a: e.datos.a, actor: e.datos.actor, motivo: e.datos.motivo };\n  } else if (e.tipo === 'support.requested') {\n    sobre.data = {\n      codigo: inc.codigo, motivo: inc.motivo, mensaje: inc.mensaje.trim(), pedido: inc.pedido_codigo ?? null,\n      cliente: { nombre: inc.cliente.nombre, email: inc.cliente.email.trim().toLowerCase() },\n    };\n  } else {\n    // El cambio a «pagado» llega en su propio order.status_changed; el pago solo se deja registrado.\n    sobre.data = {\n      flujo: 'n8n-eventos-tienda', escenario: 'pedido', event_id: e.id, resultado: 'ok',\n      datos_entrada: { pedido: p.codigo, pago: e.datos.resultado, pasarela: e.datos.pasarela ?? 'tarjeta_simulada' },\n    };\n  }\n  salida.sobre = sobre;\n}\nreturn [{ json: salida }];"
      },
