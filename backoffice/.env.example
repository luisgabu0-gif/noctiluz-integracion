# Copia como .env SOLO para probar en local. En Render se ponen en «Environment» del servicio.
# Nunca subas .env al repositorio.

# Render → base de datos → «Internal Database URL». Vacío = SQLite local en datos/backoffice.sqlite
DATABASE_URL=

# Token que n8n manda en la cabecera X-Api-Token (credencial Header Auth en n8n). Mín. 20 caracteres.
BACKOFFICE_API_TOKEN=

# Webhook de producción del flujo «NOCTILUZ · 2 Estado back-office → tienda» y su token (cabecera X-Noctiluz-Token)
N8N_WEBHOOK_ESTADO=https://noctiluz-n8n.onrender.com/webhook/estado-backoffice
N8N_WEBHOOK_TOKEN=

# Tienda: el cuadro de mando le pide el embudo y la cola. El token es el integracion.token de su config.php
TIENDA_URL=https://www.noctiluz.onl
TIENDA_API_TOKEN=

# Secreto compartido con la tienda para firmar el enlace de Telegram del pedido
TELEGRAM_VINCULO_SECRETO=

# Primer usuario del panel (solo se usa si la tabla usuarios está vacía). Contraseña de 10+ caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# desarrollo = muestra el detalle de los errores; produccion = los oculta
APP_ENV=produccion
